# Copiar a .env para desarrollo local. NUNCA subir el .env real al repositorio.
# En Render estas variables se configuran en el panel (Environment).

DJANGO_SECRET_KEY=cambiar-por-una-cadena-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Núcleo del docente (M1 simulado vive dentro de este mismo servicio, en /api/registro)
NUCLEO_URL=https://nucleo-tr.onrender.com

# MongoDB Atlas (cadena de conexión SRV). Local: mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB=tr_adopciones
